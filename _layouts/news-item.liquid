---
layout: default
permalink: "/news/{{ page.date | date: '%Y/%m/%d' }}/{{ page.fileSlug }}/"
body_classes:
  - news-item
---
{%- assign author = authors[author] -%}
<main class='flex-shrink-0'>
  <article itemscope itemtype='http://schema.org/Article'>
    <!-- ================= title and byline ============================ -->
    <header class='entry-head'>
      <div class='wrap'>
        <p class='entry-meta'>
          <span class='entry-cat'>{{ category }}</span>
          <time
            class='entry-date'
            itemprop='datePublished'
            datetime='{{ page.date | date: '%Y-%m-%d' }}'
          >
            {{- page.date | date_to_string -}}
          </time>
        </p>
        <h1 class='entry-title' itemprop='headline'>{{ title }}</h1>
        <a
          class='entry-author'
          href='{{ author.url }}'
          itemprop='author'
          itemscope
          itemtype='http://schema.org/Person'
        >
          <img
            class='entry-avatar'
            src='{{ author.avatar }}'
            alt=''
            width='24'
            height='24'
          >
          <span itemprop='name'>{{ author.name }}</span>
        </a>
      </div>
    </header>

    <!-- ================= the post ==================================== -->
    <div class='entry-body' itemprop='articleBody'>
      <div class='wrap'>
        <div class='entry-prose'>{{ content }}</div>
      </div>
    </div>
  </article>

  {%- assign prev_post = collections.posts | getPreviousCollectionItem -%}
  {%- assign next_post = collections.posts | getNextCollectionItem -%}
  {%- if prev_post or next_post %}
    <!-- ================= what sits either side ======================= -->
    <nav class='entry-nav' aria-label='Other posts'>
      <div class='wrap entry-nav-grid'>
        {%- if next_post %}
          <a class='entry-step entry-step-older' href='{{ next_post.url }}'>
            <span class='entry-step-dir'>Older</span>
            <span class='entry-step-title'>{{ next_post.data.title }}</span>
          </a>
        {%- endif %}
        {%- if prev_post %}
          <a class='entry-step entry-step-newer' href='{{ prev_post.url }}'>
            <span class='entry-step-dir'>Newer</span>
            <span class='entry-step-title'>{{ prev_post.data.title }}</span>
          </a>
        {%- endif %}
      </div>
    </nav>
  {%- endif %}
</main>
