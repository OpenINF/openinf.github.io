{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  autoApprove: true,
  automerge: true,
  extends: [
    "config:best-practices",
    ":gitSignOff",
    ":preserveSemverRanges",
    "mergeConfidence:all-badges",
    "schedule:earlyMondays",
  ],
  // `config:best-practices` pulls in `abandonments:recommended`, which calls a
  // package abandoned after a year without a release. Most of what that flags
  // here is the unified ecosystem, where packages are small and finished
  // rather than neglected -- 23 of the 49 it listed had shipped within the
  // previous two years. Per-package community overrides still apply.
  abandonmentThreshold: "2 years",
  groupName: "all",
  ignorePresets: [":prHourlyLimit2"],
  vulnerabilityAlerts: {
    labels: ["🗝️ Type: Security"],
    automerge: true,
    assignees: ["@DerekNonGeneric"],
  },
  lockFileMaintenance: {
    enabled: true,
    labels: ["📦 Type: Dependencies", "🔧 Type: Maintenance"],
  },
  platformCommit: "enabled",
  rangeStrategy: "pin",
  // A dependency pull request lands as a commit like any other, so its title
  // follows the organization's format: a category emoji, then `：` with no
  // space after it. `commitMessagePrefix` cannot express that, because the
  // default template puts a space between the prefix and the rest, and
  // `commitMessageAction` cannot either, because pins, rollbacks, replacements
  // and lock file maintenance each set their own. That leaves the template,
  // which renovate warns is deprecated while offering nothing else that can
  // put the emoji flush against the rest. The action is lowercased there
  // because those same presets capitalize it ("Lock file maintenance", "Pin")
  // and our subjects start lowercase; the topic keeps its case, since it is a
  // package name.
  semanticCommits: "disabled",
  commitMessage: "📦：{{{lowercase commitMessageAction}}} {{{commitMessageTopic}}} {{{commitMessageExtra}}} {{{commitMessageSuffix}}}",
  commitMessageAction: "bump",
  commitMessageTopic: "{{depName}}",
  // Nothing else watches these two files. Everything installed through npm is
  // covered by the managers above, but a version pinned in a URL or a shell
  // variable is invisible to renovate without being told -- which is how the
  // dprint dockerfile plugin reached four years out of date and stopped being
  // able to parse a digest-pinned FROM line.
  customManagers: [
    {
      customType: "regex",
      description: "dprint plugins, pinned by URL in dprint.json",
      managerFilePatterns: ["/^dprint\\.json$/"],
      matchStrings: [
        "https://plugins\\.dprint\\.dev/(?<depName>[a-z-]+)-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm",
      ],
      depNameTemplate: "dprint/dprint-plugin-{{{depName}}}",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "fish tooling pinned in the dev container post-create script",
      managerFilePatterns: ["/^\\.devcontainer/post-create\\.sh$/"],
      // Both halves: moving one and leaving the other would leave the file
      // naming a release it does not install.
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\sreadonly \\w+=(?<currentDigest>[0-9a-f]{40}) # (?<currentValue>\\S+)",
      ],
    },
  ],

  packageRules: [
    {
      matchDepTypes: ["dependencies"],
      labels: ["📦 Type: Dependencies"],
    },
    {
      matchDepTypes: ["devDependencies"],
      labels: ["📦 Type: Developer Dependencies", "🏗️ Category: Build"],
    },
    // `config:best-practices` already waits, through
    // `security:minimumReleaseAgeNpm`, but only three days and only for npm --
    // leaving the action digests and the URL-pinned dprint plugins with no
    // wait at all. A preset's rules are merged ahead of these, and the last
    // matching rule wins, so raising the figure has to happen here.
    {
      description: "Let a new release be looked at before taking it",
      matchPackageNames: ["*"],
      minimumReleaseAge: "7 days",
    },
    {
      // Restores what the preset set and the rule above would undo: renovate
      // cannot apply the wait to the transitive versions a lockfile refresh
      // picks up. pnpm enforces it there instead, during the install renovate
      // runs to produce the branch.
      description: "Lock file maintenance resolves through the package manager",
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: null,
    },
  ],
}
