<footer class='site-footer py-3 mt-auto'>
  <p class='text-center text-body-tertiary my-0'>
    &copy; {{ buildTime | date: '%Y' }} The OpenINF Authors &amp; Friends
  </p>
</footer>

<script>
  // Bento arrives from a CDN, so the page draws and takes taps before the
  // runtime lands. The buttons are bound here and wait on the API inside the
  // handler, so a tap made in that gap opens the sidebar rather than falling
  // on the floor.
  const sidebarReady = customElements
    .whenDefined('bento-sidebar')
    .then(() => document.querySelector('#sidebar').getApi());

  // Bento slides the sidebar in over 350ms, and the panel and its backdrop
  // both cross the button on the way. A tap during that stretch lands on
  // whatever is passing underneath, so the sidebar stops taking taps and the
  // toggle is ignored until it settles.
  const slideDuration = 350;
  let busy = false;

  for (const button of document.querySelectorAll('.navbar-toggler')) {
    button.addEventListener('click', async () => {
      if (busy) return;
      busy = true;
      document.documentElement.dataset.sidebarBusy = '';

      const api = await sidebarReady;
      api.toggle();

      setTimeout(() => {
        busy = false;
        delete document.documentElement.dataset.sidebarBusy;
      }, slideDuration);
    });
  }

  // The buttons say which state they are in. Reading it off the element keeps
  // the answer right when the sidebar closes on the backdrop or on Escape.
  const sidebar = document.querySelector('#sidebar');
  const togglers = document.querySelectorAll('.navbar-toggler');

  new MutationObserver(() => {
    const expanded = String(sidebar.hasAttribute('open'));
    for (const toggler of togglers) {
      toggler.setAttribute('aria-expanded', expanded);
    }
  }).observe(sidebar, { attributeFilter: ['open'] });
</script>
