<head>
  <meta charset='utf-8'>
  {%- comment -%}
    No scale limits: iOS ignores them, and elsewhere they take pinch-zoom
    from anyone who needs it.
  {%- endcomment -%}
  <meta name='viewport' content='width=device-width,initial-scale=1'>
  <link rel='icon' type='image/svg+xml' href='/assets/img/logogram.svg'>
  <meta
    name='description'
    content='{{ description | default: siteDescription }}'
  >
  <meta name='format-detection' content='telephone=no'>
  {% if status == 'unpublished' %}
    <meta name='robots' content='noindex, nofollow, noarchive'>
  {% endif %}
  <title>
    {% if page.url == '/' -%}
      {{- siteTitle -}}
    {%- else -%}
      {%- comment -%}
        Once, not plain escape: a hand-written title may already carry an
        entity, while an SDK API title such as Guard<T> is plain text that
        the minifier would otherwise read as a tag.
      {%- endcomment -%}
      {{- title | escape_once }} &middot; {{ siteTitle -}}
    {%- endif %}
  </title>
  {% if env == 'production' -%}
    <script>
      if (window.location.host !== 'open.inf.is')
        window.goatcounter = { no_onload: true };
    </script>
    <script
      data-goatcounter='https://openinf.goatcounter.com/count'
      async
      src='/assets/js/vendor/count.min.js'
    ></script>
  {%- endif -%}
  <link
    rel='stylesheet'
    href='/assets/styles/main{% if env == "production" %}.min{% endif %}.css'
  >
  <link rel='canonical' href='{{ siteUrl }}{{ page.url }}'>
  {% if page.url == '/' %}
    <script type='application/ld+json'>
      {
        "@context": "http://schema.org",
        "@type": "WebSite",
        "license": "https://open.inf.is/license",
        "about": {
          "description": "{{ siteDescription }}"
        }
      }
    </script>
  {% endif %}
</head>
