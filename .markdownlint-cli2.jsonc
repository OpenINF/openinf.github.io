{
  // Include a custom rule package
  "customRules": [],

  // Define glob expressions to use (only valid at root)
  "globs": ["**.md"],

  // Define glob expressions to ignore
  "ignores": [
    "_site/",
    "node_modules/",
    "**/COPYING.md",
    // Generated by compile.siteifyHealthFiles from OpenINF/.github;
    // fixes here are overwritten on the next build.
    "collections/_docs/code-of-conduct.md",
    "collections/_docs/contributing.md",
    "collections/_docs/security.md",
    "collections/_docs/support.md",
    "collections/_pages/vision.md"
  ],

  "markdownItPlugins": [
    ["markdown-it-task-lists"],
    ["markdown-it-footnote"],
    ["markdown-it-sup"],
    ["markdown-it-sub"],
    ["markdown-it-abbr"],
    ["markdown-it-anchor"]
  ],

  // Disable inline config comments
  "noInlineConfig": false,

  // Disable progress on stdout (only valid at root)
  "noProgress": false,

  // Use a specific formatter (only valid at root)
  "outputFormatters": [["markdownlint-cli2-formatter-default"]]
}
